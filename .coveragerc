[run]
source = backend
omit =
    backend/main.py
    backend/app.py
    backend/capture/camera.py
    backend/visualization/renderer.py

[report]
fail_under = 70
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if TYPE_CHECKING:
    if __name__ == .__main__.:
    except ImportError:

[html]
directory = htmlcov
