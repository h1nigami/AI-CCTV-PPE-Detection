# ── ARM64 (Jetson) сборка ─────────────────────────────────────
# База: dustynv/l4t-pytorch:r35.3.1 (L4T R35.3.1, JetPack 5.1.3)
# Предустановлены: PyTorch, CUDA 11.4, torchvision, numpy 1.x
# blinker==1.8.2 (1.9.0 требует Python ≥3.9)
# opencv из apt (не pip) — на aarch64 Python 3.8 wheel багованный
# PIP_INDEX_URL переопределён на PyPI (jetson.webredirect.org не виден)

FROM dustynv/l4t-pytorch:${L4T_TAG:-r35.3.1}

WORKDIR /app

# ── Системные зависимости ──────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    python3-opencv \
    && rm -rf /var/lib/apt/lists/*

# ── Установка Python-зависимостей ─────────────────────────────
# --ignore-installed blinker нужен, т.к. distutils‑пакет blinker 1.4
#   не позволяет pip выполнить clean‑uninstall.
# numpy принудительно на 1.x — torch на Jetson собран с numpy‑ABI 1.x

COPY requirements.txt .

RUN PIP_INDEX_URL="https://pypi.org/simple" PIP_EXTRA_INDEX_URL="" PIP_TRUSTED_HOST="pypi.org" \
    pip install --no-cache-dir --timeout=300 --ignore-installed blinker==1.8.2

RUN PIP_INDEX_URL="https://pypi.org/simple" PIP_EXTRA_INDEX_URL="" PIP_TRUSTED_HOST="pypi.org" \
    pip install --no-cache-dir --timeout=300 \
        ultralytics \
        flask \
        waitress \
        pillow \
        onnx onnxsim

RUN PIP_INDEX_URL="https://pypi.org/simple" PIP_EXTRA_INDEX_URL="" PIP_TRUSTED_HOST="pypi.org" \
    pip install --no-cache-dir --timeout=300 "numpy<2"

# onnxruntime-gpu для Jetson (ARM64 + CUDA 11)
RUN PIP_INDEX_URL="https://pypi.org/simple" PIP_TRUSTED_HOST="pypi.org" \
    pip install --no-cache-dir --timeout=300 \
    --extra-index-url https://aiinfra.pkgs.visualstudio.com/PublicPackages/_packaging/onnxruntime-cuda-12/pypi/simple/ \
    onnxruntime-gpu 2>&1 || \
    ( echo "onnxruntime-gpu не найден, пробуем onnxruntime (CPU)..." && \
      PIP_INDEX_URL="https://pypi.org/simple" PIP_EXTRA_INDEX_URL="" PIP_TRUSTED_HOST="pypi.org" \
      pip install --no-cache-dir --timeout=300 onnxruntime 2>&1 ) || \
    echo "WARNING: onnxruntime не установлен. Re-ID и YOLO будут на CPU."

# InsightFace для распознавания лиц
RUN PIP_INDEX_URL="https://pypi.org/simple" PIP_EXTRA_INDEX_URL="" PIP_TRUSTED_HOST="pypi.org" \
    pip install --no-cache-dir --timeout=300 insightface==0.7.3

# onnxruntime может переустановить numpy ≥2 — возвращаем 1.x
RUN PIP_INDEX_URL="https://pypi.org/simple" PIP_EXTRA_INDEX_URL="" PIP_TRUSTED_HOST="pypi.org" \
    pip install --no-cache-dir --timeout=300 "numpy<2" --force-reinstall

# ── Код приложения ─────────────────────────────────────────
COPY . .
# Удаляем pip-шный opencv (ставили из apt), чистим gapi (циклический импорт)
RUN rm -rf /usr/local/lib/python*/dist-packages/{cv2,cv2*.dist-info,opencv*} 2>/dev/null; \
    pip uninstall -y opencv-python opencv-python-headless opencv-contrib-python 2>/dev/null || true; \
    mkdir -p uploads models data

EXPOSE 8000
# При первом старте экспортирует .pt → .engine (TensorRT FP16)
# Требует --runtime nvidia, поэтому делается в CMD, а не в RUN
# .engine сохраняются в /app/models — для персистентности смонтируйте volume
RUN chmod +x entrypoint.sh
CMD ["/app/entrypoint.sh"]
