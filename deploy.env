# Единая конфигурация деплоя. ПРИ СМЕНЕ СЕРВЕРОВ ПРАВИТЬ ТОЛЬКО ЗДЕСЬ.
# Читается и deploy.sh (перенос/перезапуск), и docker-compose.frontend.yml (env_file).
# Формат строгий: KEY=value, без пробелов вокруг '=' и без кавычек.

# ── Бэкенд (Docker, GPU) ──────────────────────────────────
BACKEND_HOST=best@192.168.0.97
BACKEND_DIR=AI-CCTV-PPE-Detection

# ── Фронтенд (nginx reverse-proxy) ────────────────────────
FRONTEND_HOST=nvidia@192.168.0.85
FRONTEND_DIR=kontroller-frontend

# ── Адрес бэка, на который фронт-nginx проксирует API ─────
# (попадает внутрь фронт-контейнера, nginx подставляет его в конфиг)
BACKEND_URL=http://192.168.0.97:8000
